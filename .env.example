# Public URL of the site (no trailing slash) — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://esticalc.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@esticalc.com

# Google AdSense — publisher id from AdSense > Account > Account information.
# Setting this adds the AdSense script, the google-adsense-account meta tag and /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot ids (AdSense > Ads > By ad unit). Leave empty to rely on Auto ads only.
NEXT_PUBLIC_ADSENSE_SLOT_CALCULATOR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Set to 1 to show grey placeholder boxes where ads will appear (for layout checks only).
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=

# Optional
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
